; ============================================================================
; VIDEO TEXT MANAGER - Курсор, управление, escape-коды
; ============================================================================
module video_text

EXTERN cursor_x, cursor_y
EXTERN char_render
EXTERN fg_color, bg_color, pal_set_colors

; ----------------------------------------------------------------------------
; text_put_char - Вывести символ с обработкой управления
; Вход: A = символ
; ----------------------------------------------------------------------------
PUBLIC text_put_char
text_put_char:
    CP 0x08      ; Backspace
    JR Z, @bs
    CP 0x09      ; Tab
    JR Z, @tab
    CP 0x0A      ; LF
    JR Z, @lf
    CP 0x0D      ; CR
    JR Z, @cr
    CP '\\'      ; Escape
    JR Z, @esc
    CP ' '       ; Управляющий символ?
    JR C, @ret
    
    ; Обычный символ
    PUSH AF
    CALL text_calc_cursor_addr  ; DE = адрес
    POP AF
    CALL char_render
    
    ; Сдвинуть курсор
    LD A, (cursor_x)
    INC A
    LD (cursor_x), A
    CP 80
    RET C
    
    ; Перенос строки
    XOR A
    LD (cursor_x), A
    LD A, (cursor_y)
    INC A
    LD (cursor_y), A
    CP 25
    RET C
    
    ; Прокрутка
    DEC A
    LD (cursor_y), A
    CALL text_scroll_up
@ret:
    RET

@bs:    ; Backspace
    LD A, (cursor_x)
    OR A
    JR Z, .bs_prev_line
    DEC A
    LD (cursor_x), A
    RET
@bs_prev_line:
    LD A, 79
    LD (cursor_x), A
    LD A, (cursor_y)
    OR A
    RET Z
    DEC A
    LD (cursor_y), A
    RET

@tab:   ; Tab (4 пробела)
    LD B, 4
@tab_loop:
    LD A, ' '
    CALL text_put_char
    DJNZ @tab_loop
    RET

@lf:    ; Line Feed
    LD A, (cursor_y)
    INC A
    LD (cursor_y), A
    CP 25
    RET C
    DEC A
    LD (cursor_y), A
    JP text_scroll_up

@cr:    ; Carriage Return
    XOR A
    LD (cursor_x), A
    RET

@esc:   ; Escape последовательности
    ; Обработка \c, \p, \C и т.д.
    RET

; ----------------------------------------------------------------------------
; text_process_escape - Обработка escape-последовательности
; Вход: HL = указатель на последовательность
; ----------------------------------------------------------------------------
text_process_escape:
    INC HL
    LD A, (HL)
    CP 'c'      ; \c<fg><bg> - цвет
    JR Z, @esc_color
    CP 'p'      ; \p<xx><yy> - позиция
    JR Z, @esc_pos
    CP 'C'      ; \C - очистка
    JR Z, @esc_clear
    RET

@esc_color:
    INC HL
    LD A, (HL)  ; Цвет текста
    INC HL
    LD B, (HL)  ; Цвет фона
    JP pal_set_colors

@esc_pos:
    INC HL
    LD A, (HL)  ; X
    LD (cursor_x), A
    INC HL
    LD A, (HL)  ; Y
    LD (cursor_y), A
    RET

@esc_clear:
    JP text_clear_screen