; VIDEO CRTC CONTROLLER - Управление CRTC и расширенными регистрами
; ============================================================================
.module video_crt

; =============== КОНСТАНТЫ ===============
MMIO_PAGE     equ 0xF1
CRTC_INDEX    equ 0x20
CRTC_DATA     equ 0x21

; =============== ТАБЛИЦЫ ГРАФИЧЕСКИХ РЕЖИМОВ ===============

include "vide_crt_incl.asm"

; =============== ПУБЛИЧНЫЕ ФУНКЦИИ ===============
PUBLIC crtc_set_mode, crtc_set_start_addr
PUBLIC crtc_set_palette, crtc_set_palette_color

; ----------------------------------------------------------------------------
; crtc_set_mode - Установить режим CRTC
; Вход: HL = указатель на таблицу [reg,val,mask]...
;       B = количество записей
; ----------------------------------------------------------------------------
crtc_set_mode:
    LD A, 3          ; Страница MMIO для CRTC
    OUT (MMIO_PAGE), A
    
    LD C, CRTC_INDEX
@loop:
    LD A, (HL)      ; Регистр
    OUT (C), A
    INC HL
    
    INC C           ; CRTC_DATA
    LD A, (HL)      ; Значение
    OUT (C), A
    INC HL
    
    LD A, (HL)      ; Маска (пока не используем)
    INC HL
    
    DEC C           ; Вернуться к INDEX
    DJNZ @loop
    RET

; ----------------------------------------------------------------------------
; crtc_set_start_addr - Установить начальный адрес отображения
; Вход: HL = адрес в VRAM (0-65535)
; ----------------------------------------------------------------------------
crtc_set_start_addr:
    LD A, 3
    OUT (MMIO_PAGE), A
    
    LD A, 0x0C      ; START_ADDR_H
    OUT (CRTC_INDEX), A
    LD A, H
    OUT (CRTC_DATA), A
    
    LD A, 0x0D      ; START_ADDR_L  
    OUT (CRTC_INDEX), A
    LD A, L
    OUT (CRTC_DATA), A
    RET


