; VIDEO GRAPHICS PRIMITIVES - Точки, линии, прямоугольники
; ============================================================================
module video_gfx

EXTERN current_mode, bytes_per_line, bytes_per_pixel
EXTERN fg_color, bg_color

; ----------------------------------------------------------------------------
; gfx_draw_pixel - Нарисовать точку
; Вход: B = X, C = Y, A = цвет
; ----------------------------------------------------------------------------
PUBLIC gfx_draw_pixel
gfx_draw_pixel:
    PUSH AF
    CALL gfx_calc_addr  ; HL = адрес пикселя
    POP AF
    
    LD D, A
    LD A, (current_mode)
    CP 1
    JR Z, @pixel_1bpp
    CP 2
    JR Z, @pixel_2bpp
    ; ... остальные режимы
    ret
    
@pixel_1bpp:
    ; Для монохрома: цвет 0 или 1
    OR A
    JR Z, @pixel_clear
    ; Установить бит
    LD A, (HL)
    OR D  ; D содержит маску бита
    LD (HL), A
    RET
    
@pixel_clear:
    ; Сбросить бит
    LD A, (HL)
    AND D
    LD (HL), A
    RET

; ----------------------------------------------------------------------------
; gfx_calc_addr - Вычислить адрес пикселя
; Вход: B = X, C = Y
; Выход: HL = адрес, A = маска бита (для 1bpp)
; ----------------------------------------------------------------------------
gfx_calc_addr:
    ; HL = Y * bytes_per_line
    LD H, 0
    LD L, C
    LD DE, (bytes_per_line)
    CALL mul_hl_de
    
    ; + X * bytes_per_pixel
    LD A, (bytes_per_pixel)
    LD E, A
    LD D, 0
    LD A, B
    CALL mul_de_a
    ADD HL, DE
    
    ; + VRAM_BASE
    LD DE, (vram_base)
    ADD HL, DE
    
    ; Маска для 1bpp
    LD A, B
    AND 7
    LD B, A
    LD A, 0x80
@mask_loop:
    OR A
    RLCA
    DJNZ @mask_loop
    RET

