; ============================================================================
; VIDEO CHARACTER RENDERER - Преобразование шрифта в пиксели
; ============================================================================
module video_char

EXTERN _scr_font_data
EXTERN current_mode, bytes_per_line
EXTERN tetrada_table_2bpp, tetrada_table_4bpp, tetrada_table_8bpp

; ----------------------------------------------------------------------------
; char_render - Отрендерить символ
; Вход: A = код символа, DE = адрес в VRAM
; ----------------------------------------------------------------------------
PUBLIC char_render
char_render:
    ; Вычислить адрес в шрифте
    LD L, A
    LD H, 0
    ADD HL, HL  ; ×2
    ADD HL, HL  ; ×4
    ADD HL, HL  ; ×8
    LD BC, _scr_font_data
    ADD HL, BC  ; HL = шрифт
    
    ; Выбрать функцию рендеринга
    LD A, (current_mode)
    CP 1
    JP Z, char_render_1bpp
    CP 2
    JP Z, char_render_2bpp
    CP 4
    JP Z, char_render_4bpp
    JP char_render_8bpp

; ----------------------------------------------------------------------------
; char_render_1bpp - Рендеринг для монохромного режима
; ----------------------------------------------------------------------------
char_render_1bpp:
    LD B, 8
@loop:
    LD A, (HL)
    LD (DE), A
    INC HL
    
    ; Следующая строка
    LD A, E
    ADD A, 80
    LD E, A
    JR NC, .next
    INC D
@next:
    DJNZ @loop
    RET

; ----------------------------------------------------------------------------
; char_render_2bpp - Рендеринг для 4-цветного режима
; ----------------------------------------------------------------------------
char_render_2bpp:
    LD B, 8
    LD IX, tetrada_table_2bpp
@loop:
    LD A, (HL)
    INC HL
    
    ; Левая тетрада
    AND $F0
    RRCA×4
    LD C, A
    LD A, (IX + C)
    LD (DE), A
    INC DE
    
    ; Правая тетрада
    LD A, (HL-1)
    AND $0F
    LD C, A
    LD A, (IX + C)
    LD (DE), A
    INC DE
    
    ; Следующая строка
    LD A, E
    ADD A, 160 - 2
    LD E, A
    JR NC, .next
    INC D
@next:
    DJNZ @loop
    RET; video_conf.asm
