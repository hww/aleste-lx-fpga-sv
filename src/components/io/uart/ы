`default_nettype none

module uart_bridge #(
    parameter WB_ADDR_WIDTH = 24,
    parameter DBG_ADDR_WIDTH = 8,
    parameter UART_DATA_WIDTH = 8
) (
    input  logic                       clk_54m,
    input  logic                       rst,
    // UART Interface
    input  logic                       uart_rx,
    output logic                       uart_tx,
    output logic                       uart_rx_clk,
    output logic                       uart_tx_clk,
    output logic                       uart_tx_busy,
    output logic                       uart_rx_ready,

    // Wishbone Master Interface
    output logic                       wb_cyc_o,
    output logic                       wb_stb_o,
    output logic                       wb_we_o,
    output logic [1:0]                 wb_sel_o,
    output logic [WB_ADDR_WIDTH-1:0]   wb_adr_o,
    output logic [UART_DATA_WIDTH-1:0] wb_dat_o,
    input  logic [UART_DATA_WIDTH-1:0] wb_dat_i,
    input  logic                       wb_ack_i,

    // Debug Register Bus Interface
    output logic                       dbg_cyc_o,
    output logic                       dbg_stb_o,
    output logic                       dbg_we_o,
    output logic [DBG_ADDR_WIDTH-1:0]  dbg_adr_o,
    output logic [UART_DATA_WIDTH-1:0] dbg_dat_o,
    input  logic [UART_DATA_WIDTH-1:0] dbg_dat_i,
    input  logic                       dbg_ack_i,

    output logic [3:0]                 state_o
);

// ============================================================================
// Local Parameters
// ============================================================================

// Command types
localparam CMD_TYPE_MEM_READ   = 3'b000;
localparam CMD_TYPE_MEM_WRITE  = 3'b001;
localparam CMD_TYPE_REG_READ   = 3'b010;
localparam CMD_TYPE_REG_WRITE  = 3'b011;
localparam CMD_TYPE_EVENT      = 3'b100;
localparam CMD_TYPE_GLOBAL     = 3'b101;

// Data sizes
localparam SIZE_1_BYTE    = 4'b0000;
localparam SIZE_2_BYTES   = 4'b0001;
localparam SIZE_4_BYTES   = 4'b0010;
localparam SIZE_8_BYTES   = 4'b0011;
localparam SIZE_16_BYTES  = 4'b0100;
localparam SIZE_32_BYTES  = 4'b0101;
localparam SIZE_64_BYTES  = 4'b0110;
localparam SIZE_128_BYTES = 4'b0111;

// Special commands
localparam CMD_PING       = 8'hFF;
localparam RESP_PONG      = 8'hFE;
localparam RESP_ERROR     = 8'hFF;

// ============================================================================
// UART Interface
// ============================================================================

logic [7:0] uart_tx_data;
logic       uart_tx_start;
logic [7:0] uart_rx_data;
logic       uart_rx_ack;

uart uart_inst (
    .clk_i(clk_54m),
    .rst_i(rst),
    
    // transmitter
    .tx_data_i(uart_tx_data),
    .tx_wr_i(uart_tx_start),
    .tx_o(uart_tx),
    .tx_busy_o(uart_tx_busy),
    .tx_clk_o(uart_tx_clk),
    
    // receiver  
    .rx_i(uart_rx),
    .rx_ready_o(uart_rx_ready),
    .rx_ready_clr_i(uart_rx_ack),
    .rx_data_o(uart_rx_data),
    .rx_clk_o(uart_rx_clk)
);

// ============================================================================
// Command Processor FSM
// ============================================================================

typedef enum logic [3:0] {
    CMD_IDLE,
    CMD_PARSE,
    CMD_READ_ARGS,
    CMD_MEM_READ,
    CMD_MEM_WRITE,  
    CMD_REG_READ,
    CMD_REG_WRITE,
    CMD_EVENT,
    CMD_SEND_RESPONSE
} cmd_state_t;

cmd_state_t cmd_state = CMD_IDLE;

// Command registers
logic [7:0]  current_cmd;
logic [23:0] current_addr;
logic [7:0]  current_data;
logic [7:0]  data_size;
logic [2:0]  args_to_receive;
logic [7:0]  response_data;

// ============================================================================
// Wishbone Bus Interface
// ============================================================================

// Command interface
logic        wb_cmd_active;
logic        wb_cmd_ready;
logic        wb_cmd_read;
logic        wb_cmd_complete;

// Write data interface
logic        wb_wr_valid;
logic        wb_wr_ready;
logic [7:0]  wb_wr_data;

// Read data interface
logic        wb_rd_valid;
logic        wb_read_ack;
logic [7:0]  wb_rd_data;

// ============================================================================
// Debug Bus Interface
// ============================================================================

// Command interface
logic        dbg_cmd_active;
logic        dbg_cmd_ready;
logic        dbg_cmd_read;
logic        dbg_cmd_complete;

// Write data interface
logic        dbg_wr_valid;
logic        dbg_wr_ready;
logic [7:0]  dbg_wr_data;

// Read data interface
logic        dbg_rd_valid;
logic        dbg_read_ack;
logic [7:0]  dbg_rd_data;

// ============================================================================
// Helper Functions
// ============================================================================

function [7:0] get_data_size(input [7:0] cmd);
    case (cmd[3:0])
        SIZE_1_BYTE:    get_data_size = 8'd1;
        SIZE_2_BYTES:   get_data_size = 8'd2;
        SIZE_4_BYTES:   get_data_size = 8'd4;
        SIZE_8_BYTES:   get_data_size = 8'd8;
        SIZE_16_BYTES:  get_data_size = 8'd16;
        SIZE_32_BYTES:  get_data_size = 8'd32;
        SIZE_64_BYTES:  get_data_size = 8'd64;
        SIZE_128_BYTES: get_data_size = 8'd128;
        default:        get_data_size = 8'd1;
    endcase
endfunction

function [2:0] get_cmd_type(input [7:0] cmd);
    get_cmd_type = cmd[6:4];
endfunction

// ============================================================================
// Main Command FSM
// ============================================================================

always_ff @(posedge clk_54m) begin
    if (rst) begin
        cmd_state <= CMD_IDLE;
        current_cmd <= '0;
        current_addr <= '0;
        current_data <= '0;
        args_to_receive <= '0;
        data_size <= '0;
        uart_rx_ack <= '0;
        uart_tx_start <= '0;
        response_data <= '0;
        
        wb_cmd_active <= '0;
        wb_wr_valid <= '0;
        wb_read_ack <= '0;
        dbg_cmd_active <= '0;
    end else begin
        uart_rx_ack <= '0;
        uart_tx_start <= '0;
        wb_read_ack <= '0;
        dbg_cmd_active <= '0;

        case (cmd_state)
            CMD_IDLE: begin
                if (uart_rx_ready && !uart_rx_ack) begin
                    uart_rx_ack <= 1'b1;
                    current_cmd <= uart_rx_data;
                end else if (uart_rx_ack) begin
                    uart_rx_ack <= 1'b0;
                    cmd_state <= CMD_PARSE;
                end
            end
            
            CMD_PARSE: begin
                case (get_cmd_type(current_cmd))
                    CMD_TYPE_MEM_READ, CMD_TYPE_MEM_WRITE: begin
                        args_to_receive <= 3;
                        current_addr <= '0;
                        data_size <= get_data_size(current_cmd);
                        cmd_state <= CMD_READ_ARGS;
                    end
                    CMD_TYPE_REG_READ, CMD_TYPE_REG_WRITE: begin
                        args_to_receive <= 1;
                        current_addr <= '0;
                        data_size <= get_data_size(current_cmd);
                        cmd_state <= CMD_READ_ARGS;
                    end
                    CMD_TYPE_EVENT: begin
                        args_to_receive <= 2;
                        current_addr <= '0;
                        current_data <= '0;
                        data_size <= get_data_size(current_cmd);
                        cmd_state <= CMD_READ_ARGS;
                    end
                    CMD_TYPE_GLOBAL: begin
                        current_addr[7:0] <= 8'h00;
                        data_size <= get_data_size(current_cmd);
                        cmd_state <= CMD_REG_READ;
                    end
                    default: begin
                        if (current_cmd == CMD_PING) begin
                            response_data <= RESP_PONG;
                        end else begin
                            response_data <= RESP_ERROR;
                        end
                        cmd_state <= CMD_SEND_RESPONSE;
                    end
                endcase
            end
            
            CMD_READ_ARGS: begin
                if (uart_rx_ready && !uart_rx_ack) begin
                    uart_rx_ack <= 1'b1;
                    current_addr <= {current_addr[15:0], uart_rx_data};
                    args_to_receive <= args_to_receive - 1;
                end else if (uart_rx_ack) begin
                    uart_rx_ack <= 1'b0;
                    
                    if (args_to_receive == 0) begin
                        case (get_cmd_type(current_cmd))
                            CMD_TYPE_MEM_READ:  cmd_state <= CMD_MEM_READ;
                            CMD_TYPE_MEM_WRITE: cmd_state <= CMD_MEM_WRITE;
                            CMD_TYPE_REG_READ:  cmd_state <= CMD_REG_READ;
                            CMD_TYPE_REG_WRITE: cmd_state <= CMD_REG_WRITE;
                            CMD_TYPE_EVENT:     cmd_state <= CMD_EVENT;
                            default:            cmd_state <= CMD_IDLE;
                        endcase
                    end
                end
            end
            
            CMD_MEM_READ: begin
                wb_read_ack <= 1'b0;
                
                if (wb_cmd_ready && !wb_cmd_active) begin
                    wb_cmd_active <= 1'b1;
                    wb_cmd_read <= 1'b1;
                end
                
                if (wb_rd_valid && !uart_tx_busy) begin
                    uart_tx_start <= 1'b1;
                    uart_tx_data <= wb_rd_data;
                    wb_read_ack <= 1'b1;
                end
                
                if (wb_cmd_complete && wb_cmd_active) begin
                    wb_cmd_read <= 0;
                    cmd_state <= CMD_IDLE;
                end
            end
            
            CMD_MEM_WRITE: begin
                wb_wr_valid <= '0;

                if (wb_cmd_ready && !wb_cmd_active) begin
                    wb_cmd_active <= 1'b1;
                    wb_cmd_read <= 1'b0;
                end
                
                if (uart_rx_ready && !uart_rx_ack) begin
                    uart_rx_ack <= 1'b1;
                    current_data <= uart_rx_data;
                    wb_wr_valid <= 1'b1;
                end else if (uart_rx_ack) begin
                    uart_rx_ack <= 1'b0;
                end
                
                if (wb_cmd_complete && wb_cmd_active) begin
                    wb_wr_valid <= 1'b0;
                    cmd_state <= CMD_IDLE;
                end
            end 
                
            CMD_REG_READ: begin
                dbg_read_ack <= 1'b0;
                
                if (dbg_cmd_ready && !dbg_cmd_active) begin
                    dbg_cmd_active <= 1'b1;
                    dbg_cmd_read <= 1'b1;
                end
                
                if (dbg_rd_valid && !uart_tx_busy) begin
                    uart_tx_start <= 1'b1;
                    uart_tx_data <= dbg_rd_data;
                    dbg_read_ack <= 1'b1;
                end
                
                if (dbg_cmd_complete && dbg_cmd_active) begin
                    dbg_cmd_read <= 0;
                    cmd_state <= CMD_IDLE;
                end
            end

            CMD_REG_WRITE: begin
                dbg_wr_valid <= '0;

                if (dbg_cmd_ready && !dbg_cmd_active) begin
                    dbg_cmd_active <= 1'b1;
                    dbg_cmd_read <= 1'b0;
                end
                
                if (uart_rx_ready && !uart_rx_ack) begin
                    uart_rx_ack <= 1'b1;
                    current_data <= uart_rx_data;
                    dbg_wr_valid <= 1'b1;
                end else if (uart_rx_ack) begin
                    uart_rx_ack <= 1'b0;
                end
                
                if (dbg_cmd_complete && dbg_cmd_active) begin
                    dbg_wr_valid <= 1'b0;
                    cmd_state <= CMD_IDLE;
                end
            end
                        
            CMD_EVENT: begin
                response_data <= 8'h00;
                cmd_state <= CMD_SEND_RESPONSE;
            end
            
            CMD_SEND_RESPONSE: begin
                if (!uart_tx_busy) begin
                    uart_tx_start <= 1'b1;
                    uart_tx_data <= response_data;
                    cmd_state <= CMD_IDLE;
                end
            end
            
            default: cmd_state <= CMD_IDLE;
        endcase
    end
end

// ============================================================================
// Signal Assignments
// ============================================================================

assign dbg_wr_data = current_data;
assign dbg_cmd_addr = current_addr[7:0];

assign wb_wr_data = current_data;
assign wb_cmd_addr = current_addr;

// ============================================================================
// Wishbone Controller FSM
// ============================================================================

typedef enum logic [1:0] {
    WB_IDLE,
    WB_READ,
    WB_WRITE
} wb_state_t;

wb_state_t wb_state = WB_IDLE;

logic [7:0] wb_bytes_remaining;

always_ff @(posedge clk_54m) begin
    if (rst) begin
        wb_state <= WB_IDLE;
        wb_cyc_o <= '0;
        wb_stb_o <= '0;
        wb_we_o <= '0;
        wb_dat_o <= '0;
        wb_sel_o <= '0;
        wb_adr_o <= '0;
        wb_bytes_remaining <= '0;
        
        wb_cmd_ready <= '0;
        wb_wr_ready <= '0;
        wb_rd_valid <= '0;
        wb_rd_data <= '0;
        wb_cmd_complete <= '0;
    end else begin
        wb_wr_ready <= '0;
        
        case (wb_state)
            WB_IDLE: begin
                wb_cyc_o <= '0;
                wb_stb_o <= '0;
                wb_we_o <= '0;
                wb_cmd_ready <= 1'b1;
                wb_cmd_complete <= 1'b0;
                
                if (wb_cmd_active && wb_cmd_ready) begin
                    wb_cmd_ready <= 1'b0;
                    wb_adr_o <= wb_cmd_addr;
                    wb_bytes_remaining <= data_size;
                    
                    if (wb_cmd_read) begin
                        wb_state <= WB_READ;
                        wb_cyc_o <= 1'b1;
                        wb_stb_o <= 1'b1;
                        wb_we_o <= 1'b0;
                        wb_sel_o <= 2'b11;
                    end else begin
                        wb_state <= WB_WRITE;
                        wb_cyc_o <= 1'b1;
                        wb_we_o <= 1'b1;
                        wb_wr_ready <= 1'b1;
                    end
                end
            end
            
            WB_READ: begin
                if (wb_ack_i) begin
                    wb_rd_data <= wb_dat_i;
                    wb_rd_valid <= 1'b1;
                    wb_stb_o <= 1'b0;
                    wb_bytes_remaining <= wb_bytes_remaining - 1;
                end
                
                if (wb_read_ack && wb_rd_valid) begin
                    wb_rd_valid <= 1'b0;
                    
                    if (wb_bytes_remaining == 0) begin
                        wb_cyc_o <= 1'b0;
                        wb_cmd_complete <= 1'b1;
                        wb_state <= WB_IDLE;
                    end else begin
                        wb_adr_o <= wb_adr_o + 1;
                        wb_stb_o <= 1'b1;
                    end
                end
            end
            
            WB_WRITE: begin
                if (wb_wr_valid) begin
                    wb_wr_ready <= 1'b0;
                    wb_dat_o <= wb_wr_data;
                    wb_stb_o <= 1'b1;
                end
                
                if (wb_ack_i) begin
                    wb_stb_o <= 1'b0;
                    wb_bytes_remaining <= wb_bytes_remaining - 1;
                    
                    if (wb_bytes_remaining == 1) begin
                        wb_cyc_o <= 1'b0;
                        wb_cmd_complete <= 1'b1;
                        wb_state <= WB_IDLE;
                    end else begin
                        wb_adr_o <= wb_adr_o + 1;
                        wb_wr_ready <= 1'b1;
                    end
                end
            end
            
            default: wb_state <= WB_IDLE;
        endcase
    end
end

// ============================================================================
// Debug Bus Controller FSM
// ============================================================================

typedef enum logic [1:0] {
    DBG_IDLE,
    DBG_READ,
    DBG_WRITE
} dbg_state_t;

dbg_state_t dbg_state = DBG_IDLE;

logic [7:0] dbg_bytes_remaining;

always_ff @(posedge clk_54m) begin
    if (rst) begin
        dbg_state <= DBG_IDLE;
        dbg_cyc_o <= '0;
        dbg_stb_o <= '0;
        dbg_we_o <= '0;
        dbg_adr_o <= '0;
        dbg_bytes_remaining <= '0;
        
        dbg_cmd_ready <= '0;
        dbg_wr_ready <= '0;
        dbg_rd_valid <= '0;
        dbg_rd_data <= '0;
        dbg_cmd_complete <= '0;
    end else begin
        dbg_wr_ready <= '0;
        
        case (dbg_state)
            DBG_IDLE: begin
                dbg_cyc_o <= '0;
                dbg_stb_o <= '0;
                dbg_we_o <= '0;
                dbg_cmd_ready <= 1'b1;
                dbg_cmd_complete <= 1'b0;
                
                if (dbg_cmd_active && dbg_cmd_ready) begin
                    dbg_cmd_ready <= 1'b0;
                    dbg_adr_o <= dbg_cmd_addr;
                    dbg_bytes_remaining <= data_size;
                    
                    if (dbg_cmd_read) begin
                        dbg_state <= DBG_READ;
                        dbg_cyc_o <= 1'b1;
                        dbg_stb_o <= 1'b1;
                        dbg_we_o <= 1'b0;
                    end else begin
                        dbg_state <= DBG_WRITE;
                        dbg_cyc_o <= 1'b1;
                        dbg_we_o <= 1'b1;
                        dbg_wr_ready <= 1'b1;
                    end
                end
            end
            
            DBG_READ: begin
                if (dbg_ack_i) begin
                    dbg_rd_data <= dbg_dat_i;
                    dbg_rd_valid <= 1'b1;
                    dbg_stb_o <= 1'b0;
                    dbg_bytes_remaining <= dbg_bytes_remaining - 1;
                end
                
                if (dbg_read_ack && dbg_rd_valid) begin
                    dbg_rd_valid <= 1'b0;
                    
                    if (dbg_bytes_remaining == 0) begin
                        dbg_cyc_o <= 1'b0;
                        dbg_cmd_complete <= 1'b1;
                        dbg_state <= DBG_IDLE;
                    end else begin
                        dbg_adr_o <= dbg_adr_o + 1;
                        dbg_stb_o <= 1'b1;
                    end
                end
            end
            
            DBG_WRITE: begin
                if (dbg_wr_valid) begin
                    dbg_wr_ready <= 1'b0;
                    dbg_dat_o <= dbg_wr_data;
                    dbg_stb_o <= 1'b1;
                end
                
                if (dbg_ack_i) begin
                    dbg_stb_o <= 1'b0;
                    dbg_bytes_remaining <= dbg_bytes_remaining - 1;
                    
                    if (dbg_bytes_remaining == 1) begin
                        dbg_cyc_o <= 1'b0;
                        dbg_cmd_complete <= 1'b1;
                        dbg_state <= DBG_IDLE;
                    end else begin
                        dbg_adr_o <= dbg_adr_o + 1;
                        dbg_wr_ready <= 1'b1;
                    end
                end
            end
            
            default: dbg_state <= DBG_IDLE;
        endcase
    end
end

assign state_o = cmd_state;

endmodule