`default_nettype none
module uart_bridge (
    input  logic        clk_54m,      // System clock
    input  logic        rst,          // Synchronous reset
    // UART Interface
    input  logic        uart_rx,      // UART RX line
    output logic        uart_tx,      // UART TX line
    output logic        uart_rx_clk,      // UART RX clock
    output logic        uart_tx_clk,      // UART TX clock
    output logic        uart_tx_busy, // UART TX busy

    // Wishbone Master Interface
    output logic        wb_cyc_o,     // Cycle valid
    output logic        wb_stb_o,     // Strobe
    output logic        wb_we_o,      // Write enable
    output logic [1:0]  wb_sel_o,     // Byte select
    output logic [23:0] wb_adr_o,     // Address
    output logic [7:0]  wb_dat_o,     // Data output
    input  logic [7:0]  wb_dat_i,     // Data input
    input  logic        wb_ack_i,     // Acknowledge

    // Debug Register Bus Interface
    output logic        dbg_cyc_o,    // Cycle valid
    output logic        dbg_stb_o,    // Strobe
    output logic        dbg_we_o,     // Write enable
    output logic [7:0]  dbg_adr_o,    // Register address
    output logic [7:0]  dbg_dat_o,    // Write data
    input  logic [7:0]  dbg_dat_i,    // Read data
    input  logic        dbg_ack_i,    // Acknowledge

    output logic [3:0]  state_o,      // Debug state output
    output logic        uart_rx_ready // UART RX ready
);

// Внутренние сигналы для подключения UART
logic [7:0] uart_din;
logic uart_wr;
logic uart_rx_ready_clr;
logic [7:0] uart_dout;

// Инстанция UART
uart uart_inst (
    .clk_i(clk_54m),
    .rst_i(rst),
    
    // transmitter
    .tx_data_i(uart_din),
    .tx_wr_i(uart_wr), 
    .tx_o(uart_tx),
    .tx_busy_o(uart_tx_busy),
    .tx_clk_o(uart_tx_clk),
    // receiver  
    .rx_i(uart_rx),
    .rx_ready_o(uart_rx_ready),
    .rx_ready_clr_i(uart_rx_ready_clr),
    .rx_data_o(uart_dout),
    .rx_clk_o(uart_rx_clk)
);

// ============================================================================
// Main Command Processor FSM
// ============================================================================

// УПРОЩАЕМ состояния - убираем лишние START и WAIT
typedef enum logic [3:0] {
    CMD_IDLE,
    CMD_READ_ARGS,
    CMD_MEM_READ,
    CMD_MEM_WRITE,  
    CMD_REG_READ,
    CMD_REG_WRITE,
    CMD_EVENT,
    CMD_SEND_RESPONSE
} cmd_state_t;

cmd_state_t cmd_state = CMD_IDLE;

// Регистры команды и аргументов
logic [7:0]  cmd_reg;
logic [23:0] addr_reg;
logic [7:0]  data_reg;
logic [7:0]  arg_counter;
logic [7:0]  data_size;

// Ответы
logic [7:0] response_data;

// ============================================================================
// Протокол обмена с Wishbone контроллером
// ============================================================================

// Командный интерфейс
logic        wb_cmd_valid;
logic        wb_cmd_ready;
logic        wb_cmd_read;
logic [23:0] wb_cmd_addr;
logic [7:0]  wb_cmd_size;

// Интерфейс данных для записи
logic        wb_wr_valid;
logic        wb_wr_ready;
logic [7:0]  wb_wr_data;

// Интерфейс данных для чтения
logic        wb_rd_valid;
logic        wb_rd_ready;
logic [7:0]  wb_rd_data;

// Статусный интерфейс
logic        wb_busy;

// ============================================================================
// Протокол обмена с Debug Bus контроллером
// ============================================================================

// Командный интерфейс
logic        dbg_cmd_valid;
logic        dbg_cmd_ready;
logic        dbg_cmd_read;
logic [7:0]  dbg_cmd_addr;
logic [7:0]  dbg_cmd_wdata;

// Ответ
logic        dbg_resp_valid;
logic [7:0]  dbg_resp_rdata;
logic        dbg_busy;

// Расчет размера данных
function [7:0] get_data_size(input [7:0] cmd);
    case (cmd[3:0])
        4'b0000: get_data_size = 8'd1;
        4'b0001: get_data_size = 8'd2; 
        4'b0010: get_data_size = 8'd4;
        4'b0011: get_data_size = 8'd8;
        4'b0100: get_data_size = 8'd16;
        4'b0101: get_data_size = 8'd32;
        4'b0110: get_data_size = 8'd64;
        4'b0111: get_data_size = 8'd128;
        default: get_data_size = 8'd1;
    endcase
endfunction

// Определение типа команды
function [2:0] get_cmd_type(input [7:0] cmd);
    get_cmd_type = cmd[6:4];
endfunction

// Main Command FSM - УПРОЩЕННАЯ ВЕРСИЯ
always_ff @(posedge clk_54m) begin
    if (rst) begin
        cmd_state <= CMD_IDLE;
        cmd_reg <= '0;
        addr_reg <= '0;
        data_reg <= '0;
        arg_counter <= '0;
        data_size <= '0;
        uart_rx_ready_clr <= '0;
        uart_wr <= '0;
        response_data <= '0;
        
        // Сброс интерфейсов
        wb_cmd_valid <= '0;
        wb_wr_valid <= '0;
        wb_rd_ready <= '0;
        dbg_cmd_valid <= '0;
    end else begin
        // Сброс импульсных сигналов по умолчанию
        uart_rx_ready_clr <= '0;
        uart_wr <= '0;
        wb_cmd_valid <= '0;
        wb_wr_valid <= '0;
        wb_rd_ready <= '0;
        dbg_cmd_valid <= '0;

        case (cmd_state)
            CMD_IDLE: begin
                if (uart_rx_ready) begin
                    uart_rx_ready_clr <= 1'b1;
                end else if (uart_rx_ready_clr) begin
                    uart_rx_ready_clr <= 1'b0;
                    if (uart_dout == 8'hFF) begin
                        // Ping command - immediate response
                        response_data <= 8'hFE;
                        cmd_state <= CMD_SEND_RESPONSE;
                    end else if (get_cmd_type(uart_dout) == 3'b101) begin
                        // Global status - shortcut to read register 0
                        cmd_reg <= uart_dout;
                        addr_reg[7:0] <= 8'h00;
                        data_size <= get_data_size(uart_dout);
                        cmd_state <= CMD_REG_READ;
                    end else begin
                        // Normal command
                        cmd_reg <= uart_dout;
                        arg_counter <= '0;
                        addr_reg <= '0;
                        data_reg <= '0;
                        data_size <= get_data_size(uart_dout);
                        cmd_state <= CMD_READ_ARGS;
                    end
                end
            end
            
            CMD_READ_ARGS: begin
                if (uart_rx_ready) begin
                    uart_rx_ready_clr <= 1'b1;
                end else if (uart_rx_ready_clr) begin
                    uart_rx_ready_clr <= 1'b0;
                    
                    case (get_cmd_type(cmd_reg))
                        3'b000, 3'b001: begin // Memory read/write - 3 byte address
                            addr_reg <= {addr_reg[15:0], uart_dout};
                            arg_counter <= arg_counter + 1;
                            if (arg_counter == 2) begin
                                if (get_cmd_type(cmd_reg) == 3'b000)
                                    cmd_state <= CMD_MEM_READ;
                                else
                                    cmd_state <= CMD_MEM_WRITE;
                            end
                        end
                        3'b010, 3'b011: begin // Register read/write - 1 byte address
                            addr_reg[7:0] <= uart_dout;
                            if (get_cmd_type(cmd_reg) == 3'b010)
                                cmd_state <= CMD_REG_READ;
                            else
                                cmd_state <= CMD_REG_WRITE;
                        end
                        3'b100: begin // Events - 2 bytes
                            if (arg_counter == 0)
                                addr_reg[7:0] <= uart_dout; // event_id
                            else
                                data_reg <= uart_dout; // parameter
                            arg_counter <= arg_counter + 1;
                            if (arg_counter == 1)
                                cmd_state <= CMD_EVENT;
                        end
                        default: begin // Unknown command
                            response_data <= 8'hFF;
                            cmd_state <= CMD_SEND_RESPONSE;
                        end
                    endcase
                end
            end
            
            CMD_MEM_READ: begin
                if (!wb_busy && !wb_cmd_valid) begin
                    wb_cmd_valid <= 1'b1;
                    wb_cmd_read <= 1'b1;
                    wb_cmd_addr <= addr_reg;
                    wb_cmd_size <= data_size;
                end
                
                if (wb_rd_valid) begin
                    uart_wr <= 1'b1;
                    uart_din <= wb_rd_data;
                    wb_rd_ready <= 1'b1;
                end
                
                if (!wb_busy && wb_cmd_valid) begin
                    cmd_state <= CMD_IDLE;
                end
            end
            
            CMD_MEM_WRITE: begin
                if (uart_rx_ready && wb_wr_ready) begin
                    uart_rx_ready_clr <= 1'b1;
                    wb_wr_valid <= 1'b1;
                    wb_wr_data <= uart_dout;
                end
                
                if (!wb_busy) begin
                    cmd_state <= CMD_IDLE;
                end
            end
            
            CMD_REG_READ: begin
                if (!dbg_busy && !dbg_cmd_valid) begin
                    dbg_cmd_valid <= 1'b1;
                    dbg_cmd_read <= 1'b1;
                    dbg_cmd_addr <= addr_reg[7:0];
                end
                
                if (dbg_resp_valid) begin
                    response_data <= dbg_resp_rdata;
                    cmd_state <= CMD_SEND_RESPONSE;
                end
            end
            
            CMD_REG_WRITE: begin
                if (uart_rx_ready) begin
                    uart_rx_ready_clr <= 1'b1;
                end else if (uart_rx_ready_clr) begin
                    uart_rx_ready_clr <= 1'b0;
                    if (!dbg_busy && !dbg_cmd_valid) begin
                        dbg_cmd_valid <= 1'b1;
                        dbg_cmd_read <= 1'b0;
                        dbg_cmd_addr <= addr_reg[7:0];
                        dbg_cmd_wdata <= uart_dout;
                    end
                end
                
                if (dbg_resp_valid) begin
                    cmd_state <= CMD_IDLE;
                end
            end
            
            CMD_EVENT: begin
                // Event processing - for now just acknowledge
                response_data <= 8'h00;
                cmd_state <= CMD_SEND_RESPONSE;
            end
            
            CMD_SEND_RESPONSE: begin
                if (!uart_tx_busy) begin
                    uart_wr <= 1'b1;
                    uart_din <= response_data;
                    cmd_state <= CMD_IDLE;
                end
            end
            
            default: cmd_state <= CMD_IDLE;
        endcase
    end
end

// ============================================================================
// Wishbone Block Controller FSM
// ============================================================================

typedef enum logic [1:0] {
    WB_IDLE,
    WB_READ,
    WB_WRITE
} wb_state_t;

wb_state_t wb_state = WB_IDLE;

// Wishbone регистры
logic [23:0] wb_current_addr;
logic [7:0]  wb_bytes_remaining;

assign wb_adr_o = wb_current_addr;

// Wishbone FSM - УПРОЩЕННАЯ ВЕРСИЯ
always_ff @(posedge clk_54m) begin
    if (rst) begin
        wb_state <= WB_IDLE;
        wb_cyc_o <= '0;
        wb_stb_o <= '0;
        wb_we_o <= '0;
        wb_dat_o <= '0;
        wb_sel_o <= '0;
        wb_current_addr <= '0;
        wb_bytes_remaining <= '0;
        
        wb_cmd_ready <= '0;
        wb_wr_ready <= '0;
        wb_rd_valid <= '0;
        wb_rd_data <= '0;
        wb_busy <= '0;
    end else begin
        wb_rd_valid <= '0;
        wb_wr_ready <= '0';
        
        case (wb_state)
            WB_IDLE: begin
                wb_cyc_o <= '0;
                wb_stb_o <= '0;
                wb_we_o <= '0';
                wb_cmd_ready <= 1'b1;
                wb_busy <= 1'b0;
                
                if (wb_cmd_valid && wb_cmd_ready) begin
                    wb_cmd_ready <= 1'b0;
                    wb_busy <= 1'b1;
                    wb_current_addr <= wb_cmd_addr;
                    wb_bytes_remaining <= wb_cmd_size;
                    
                    if (wb_cmd_read) begin
                        wb_state <= WB_READ;
                        wb_cyc_o <= 1'b1;
                        wb_stb_o <= 1'b1;
                        wb_we_o <= 1'b0;
                        wb_sel_o <= 2'b11;
                    end else begin
                        wb_state <= WB_WRITE;
                        wb_cyc_o <= 1'b1;
                        wb_we_o <= 1'b1;
                        wb_wr_ready <= 1'b1;
                    end
                end
            end
            
            WB_READ: begin
                if (wb_ack_i) begin
                    wb_rd_valid <= 1'b1;
                    wb_rd_data <= wb_dat_i;
                    wb_stb_o <= 1'b0;
                    wb_bytes_remaining <= wb_bytes_remaining - 1;
                    
                    if (wb_rd_ready) begin
                        wb_rd_valid <= 1'b0;
                        
                        if (wb_bytes_remaining == 1) begin
                            wb_cyc_o <= 1'b0;
                            wb_state <= WB_IDLE;
                        end else begin
                            wb_current_addr <= wb_current_addr + 1;
                            wb_stb_o <= 1'b1;
                        end
                    end
                end
            end
            
            WB_WRITE: begin
                if (wb_wr_valid && wb_wr_ready) begin
                    wb_wr_ready <= 1'b0;
                    wb_dat_o <= wb_wr_data;
                    wb_stb_o <= 1'b1;
                end
                
                if (wb_ack_i) begin
                    wb_stb_o <= 1'b0;
                    wb_bytes_remaining <= wb_bytes_remaining - 1;
                    
                    if (wb_bytes_remaining == 1) begin
                        wb_cyc_o <= 1'b0;
                        wb_state <= WB_IDLE;
                    end else begin
                        wb_current_addr <= wb_current_addr + 1;
                        wb_wr_ready <= 1'b1;
                    end
                end
            end
            
            default: wb_state <= WB_IDLE;
        endcase
    end
end

// ============================================================================
// Debug Bus Controller FSM
// ============================================================================

typedef enum logic [1:0] {
    DBG_IDLE,
    DBG_READ,
    DBG_WRITE
} dbg_state_t;

dbg_state_t dbg_state = DBG_IDLE;

// Debug Bus регистры
logic [7:0] dbg_current_addr;
logic [7:0] dbg_wdata_reg;

assign dbg_adr_o = dbg_current_addr;
assign dbg_dat_o = dbg_wdata_reg;

// Debug Bus FSM - УПРОЩЕННАЯ ВЕРСИЯ
always_ff @(posedge clk_54m) begin
    if (rst) begin
        dbg_state <= DBG_IDLE;
        dbg_cyc_o <= '0;
        dbg_stb_o <= '0;
        dbg_we_o <= '0;
        dbg_current_addr <= '0;
        dbg_wdata_reg <= '0';
        
        dbg_cmd_ready <= '0;
        dbg_resp_valid <= '0';
        dbg_resp_rdata <= '0';
        dbg_busy <= '0';
    end else begin
        dbg_resp_valid <= '0';
        
        case (dbg_state)
            DBG_IDLE: begin
                dbg_cyc_o <= '0;
                dbg_stb_o <= '0;
                dbg_we_o <= '0;
                dbg_cmd_ready <= 1'b1;
                dbg_busy <= 1'b0;
                
                if (dbg_cmd_valid && dbg_cmd_ready) begin
                    dbg_cmd_ready <= 1'b0;
                    dbg_busy <= 1'b1;
                    dbg_cyc_o <= 1'b1;
                    dbg_stb_o <= 1'b1;
                    dbg_we_o <= ~dbg_cmd_read;
                    dbg_current_addr <= dbg_cmd_addr;
                    dbg_wdata_reg <= dbg_cmd_wdata;
                    
                    if (dbg_cmd_read) begin
                        dbg_state <= DBG_READ;
                    end else begin
                        dbg_state <= DBG_WRITE;
                    end
                end
            end
            
            DBG_READ: begin
                if (dbg_ack_i) begin
                    dbg_resp_valid <= 1'b1;
                    dbg_resp_rdata <= dbg_dat_i;
                    dbg_cyc_o <= 1'b0;
                    dbg_stb_o <= 1'b0;
                    dbg_state <= DBG_IDLE;
                end
            end
            
            DBG_WRITE: begin
                if (dbg_ack_i) begin
                    dbg_resp_valid <= 1'b1;
                    dbg_cyc_o <= 1'b0;
                    dbg_stb_o <= 1'b0;
                    dbg_state <= DBG_IDLE;
                end
            end
            
            default: dbg_state <= DBG_IDLE;
        endcase
    end
end

// Debug outputs
assign state_o = cmd_state;

endmodule