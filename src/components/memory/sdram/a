`default_nettype none
module sdram_wishbone #(
    parameter CLK_FREQ        = 100_000_000,     // Hz

    // Wishbone
    parameter WB_ADDR_WIDTH   = 24,
    parameter WB_DATA_WIDTH   = 16,

    // for IS42S16160B 
    parameter SDRAM_DATA_WIDTH = 16,             // 16-bit SDRAM
    parameter SDRAM_DQM_WIDTH = SDRAM_DATA_WIDTH / 8,
    parameter ROW_WIDTH = 13,        // 8K rows (A0-A12)
    parameter COL_WIDTH = 9,         // 512 columns для 16-бит (A0-A8)  
    parameter BANK_WIDTH = 2,

    // Time delays for 66.7Mhz max clock (min clock cycle 15ns)
    parameter [3:0]   CAS  = 4'd2,     // 2/3 cycles, set in mode register
    parameter [3:0]   T_WR = 4'd2,     // 2 cycles, write recovery
    parameter [3:0]   T_MRD= 4'd2,     // 2 cycles, mode register set
    parameter [3:0]   T_RP = 4'd2,     // 18-20ns, precharge to active
    parameter [3:0]   T_RCD= 4'd2,     // 18-20ns, active to r/w
    parameter [3:0]   T_RC = 4'd6,     // 60ns, ref/active to ref/active

    // Burst mode settings
    parameter [2:0] BURST_LEN = 3'b0,  // burst length 1
    parameter       BURST_MODE = 1'b0  // sequential
)
(
    // SDRAM Physical Interface
    inout  logic [SDRAM_DATA_WIDTH-1:0] SDRAM_DQ,
    output logic [12:0]                 SDRAM_A,
    output logic [1:0]                  SDRAM_BA,
    output logic                        SDRAM_nCS,
    output logic                        SDRAM_nWE,
    output logic                        SDRAM_nRAS,
    output logic                        SDRAM_nCAS,
    output logic                        SDRAM_CKE,
    output logic [SDRAM_DQM_WIDTH-1:0]  SDRAM_DQM,

    // Wishbone Interface
    input  logic                        wb_clk_i,
    input  logic                        wb_rst_i,
    input  logic                        wb_cyc_i, 
    input  logic                        wb_stb_i,
    output logic                        wb_ack_o,
    output logic                        wb_ack3_o,
    input  logic                        wb_we_i,
    input  logic [WB_ADDR_WIDTH-1:0]    wb_adr_i,
    input  logic [WB_DATA_WIDTH-1:0]    wb_dat_i,
    output logic [WB_DATA_WIDTH-1:0]    wb_dat_o,
    input  logic [WB_DATA_WIDTH/8-1:0]  wb_sel_i,
    output logic                        wb_busy_o,
    input  logic                        wb_refresh_i,
    
    // ========== DEBUG SIGNALS ==========
    output logic [2:0]                debug_state,
    output logic                      debug_init_complete,
    output logic                      debug_ready,
    output logic                      debug_initialized,
    output logic                      debug_configured,
    output logic [4:0]                debug_cycle,
    output logic                      debug_busy,
    output logic [14:0]               debug_rst_cnt,
    output logic                      debug_rst_done,
    output logic                      debug_cfg_busy
);

// States
localparam INIT     = 3'd0;
localparam CONFIG   = 3'd1;
localparam IDLE     = 3'd2;
localparam READ     = 3'd3;
localparam WRITE    = 3'd4;
localparam REFRESH  = 3'd5;

// Commands (RAS# CAS# WE#)
localparam CMD_SetModeReg  = 3'b000;
localparam CMD_AutoRefresh = 3'b001;
localparam CMD_PreCharge   = 3'b010;
localparam CMD_BankActivate= 3'b011;
localparam CMD_Write       = 3'b100;
localparam CMD_Read        = 3'b101;
localparam CMD_NOP         = 3'b111;

// ==== MODE REGISTER ДЛЯ IS42S16160B - ИСПРАВЛЕНА РАЗРЯДНОСТЬ ====
localparam MODE_RESERVED = 3'b000
localparam MODE_WRITE_BURST = 1'0;
localparam MODE_OPERATING = 2'd0;
//                                12:10              9              8:7           6:4       3          2:0
//localparam [12:0] MODE_REG = {MODE_RESERVED, MODE_WRITE_BURST, MODE_OPERATING, CAS[2:0], BURST_MODE, BURST_LEN}; // 13-бит (A0-A12)
localparam [12:0] MODE_REG = {BURST_LEN}; // 13-бит (A0-A12)

// ========== ВНУТРЕННИЕ СИГНАЛЫ ==========
logic cfg_now;
logic [4:0] cycle;
logic [2:0] state;

logic dq_oen;
logic [SDRAM_DATA_WIDTH-1:0] dq_out;
logic [SDRAM_DATA_WIDTH-1:0] dq_in;

logic rd, wr;
logic [22:0] addr;
logic wb_ack, wb_ack1, wb_ack2;
logic busy;  

// ========== АДАПТАЦИЯ ИНТЕРФЕЙСА ==========
assign rd = wb_cyc_i && wb_stb_i && !wb_we_i;
assign wr = wb_cyc_i && wb_stb_i &&  wb_we_i;
assign addr = wb_adr_i[23:1];

// ========== FSM - ИСПРАВЛЕННАЯ ВЕРСИЯ ==========
always @(posedge wb_clk_i) begin
    if (wb_rst_i) begin
        busy <= 1'b1;
        dq_oen <= 1'b0;
        SDRAM_DQM <= 2'b11;
        state <= INIT;
        wb_ack1 <= 0;
        wb_ack2 <= 0;
        wb_ack <= 0;
        cycle <= 0;
        SDRAM_A <= 0;
        SDRAM_BA <= 0;
        {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_NOP;
    end else begin
        cycle <= (cycle == 5'd31) ? 5'd31 : cycle + 5'd1;
        wb_ack2 <= wb_ack1;
        wb_ack1 <= wb_ack;
        
        // Defaults
        {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_NOP; 
        
        // Используем отдельные case для каждого состояния чтобы избежать перекрытий
        case (state)
            INIT: if (cfg_now) begin
                state <= CONFIG;
                cycle <= 0;
            end
            
            CONFIG: case (cycle)
                5'd0: begin
                    {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_PreCharge;
                    SDRAM_A[10] <= 1'b1;
                end
                T_RP: begin
                    {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_AutoRefresh;
                end
                T_RP+T_RC: begin
                    {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_AutoRefresh;
                end
                T_RP+T_RC+T_RC: begin
                    {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_SetModeReg;
                    SDRAM_A <= MODE_REG; 
                end
                T_RP+T_RC+T_RC+T_MRD: begin
                    state <= IDLE;
                    busy <= 1'b0;
                end
            endcase
            
            IDLE: if (rd | wr) begin
                {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_BankActivate;
                // ИСПРАВЛЕНА АДРЕСАЦИЯ - используем безопасные диапазоны
                if (BANK_WIDTH+COL_WIDTH+ROW_WIDTH <= 23) begin
                    SDRAM_BA <= addr[BANK_WIDTH+COL_WIDTH+ROW_WIDTH-1 -: BANK_WIDTH];
                end else begin
                    SDRAM_BA <= '0;
                end
                SDRAM_A[ROW_WIDTH-1:0] <= addr[COL_WIDTH+ROW_WIDTH-1:COL_WIDTH]; // row address
                state <= rd ? READ : WRITE;
                cycle <= 5'd1;
                busy <= 1'b1;
            end else if (wb_refresh_i) begin
                {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_AutoRefresh;
                state <= REFRESH;
                cycle <= 5'd1;
                busy <= 1'b1;            
            end
            
            READ: case (cycle)
                T_RCD: begin
                    {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_Read;
                    SDRAM_A[10] <= 1'b1; // auto precharge
                    // ИСПРАВЛЕНО: column address без лишнего бита
                    SDRAM_A[COL_WIDTH-1:0] <= addr[COL_WIDTH-1:0]; // column address
                    SDRAM_DQM <= 2'b00;
                end
                T_RCD+CAS: begin
                    wb_ack <= 1'b1;
                end
                T_RCD+CAS+5'd1: begin
                    wb_ack <= 1'b0;
                    busy <= 1'b0;
                    state <= IDLE;
                end
            endcase
            
            WRITE: case (cycle)
                T_RCD: begin
                    {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_Write;
                    SDRAM_A[10] <= 1'b1; // auto precharge
                    SDRAM_A[COL_WIDTH-1:0] <= addr[COL_WIDTH-1:0]; // column address
                    SDRAM_DQM <= ~wb_sel_i;
                    dq_out <= wb_dat_i;
                    dq_oen <= 1'b1;
                end
                T_RCD+5'd1: begin
                    dq_oen <= 1'b1;
                    wb_ack <= 1'b1;
                end
                T_RCD+T_WR+T_RP: begin
                    wb_ack <= 1'b0;
                    dq_oen <= 1'b0;
                    busy <= 1'b0;
                    state <= IDLE;
                end
            endcase
            
            REFRESH: if (cycle >= T_RC) begin
                state <= IDLE;
                busy <= 1'b0;
            end
        endcase
    end
end

// ========== INITIALIZATION LOGIC ==========
localparam INIT_CYCLES = (CLK_FREQ / 1000) * 200 / 1000;

logic [14:0] rst_cnt;
logic rst_done, rst_done_p1, cfg_busy;

always @(posedge wb_clk_i) begin
    if (wb_rst_i) begin
        rst_cnt  <= '0;
        rst_done <= 1'b0;
        cfg_busy <= 1'b1;
        rst_done_p1 <= 1'b0;
    end else begin
        rst_done_p1 <= rst_done;
        cfg_now <= rst_done & ~rst_done_p1;

        // ИСПРАВЛЕНО: сравнение с правильной разрядностью
        if (rst_cnt < INIT_CYCLES[14:0]) begin
            rst_cnt  <= rst_cnt + 1'b1;
            rst_done <= 1'b0;
            cfg_busy <= 1'b1;
        end else begin
            rst_done <= 1'b1;
            cfg_busy <= 1'b0;
        end
    end
end

// ========== УПРАВЛЕНИЕ ДАННЫМИ SDRAM ==========
assign dq_in = SDRAM_DQ;
assign SDRAM_DQ = dq_oen ? dq_out : {SDRAM_DATA_WIDTH{1'bz}};
assign SDRAM_CKE = 1'b1;
assign SDRAM_nCS = 1'b0;

assign wb_dat_o = dq_in;
assign wb_busy_o = busy;
assign wb_ack_o = wb_ack;
assign wb_ack3_o = wb_ack2;

// ========== DEBUG SIGNALS ASSIGNMENT ==========
assign debug_state = state;
assign debug_cycle = cycle[3:0]; // Усекаем для обратной совместимости
assign debug_rst_cnt = rst_cnt;
assign debug_rst_done = rst_done;
assign debug_cfg_busy = cfg_busy;
assign debug_init_complete = (state == IDLE) && rst_done && !cfg_busy;
assign debug_ready = (state == IDLE) && debug_init_complete;
assign debug_initialized = (state >= CONFIG) && rst_done;
assign debug_configured = (state >= IDLE);
assign debug_busy = (state != IDLE);

endmodule
