# Updated build.ys
# Read Verilog PLL files first
#read_verilog ../../rtl/core/hdmi_kiss/ecp5_cells.v
read_verilog ../../rtl/core/hdmi_kiss/ecp5_pll.v
read_verilog -sv ../../rtl/core/hdmi_kiss/sys_pll.sv  
read_verilog -sv ../../rtl/core/hdmi_kiss/video_pll.sv

# Then read SystemVerilog files
read_verilog -sv ../../rtl/core/hdmi_kiss/hdmi_scaler_core.sv
read_verilog -sv ../../rtl/core/hdmi_kiss/hdmi_scaler_wrapper.sv
read_verilog -sv ../../rtl/core/hdmi_kiss/tmds_encoder.sv
read_verilog -sv ../../rtl/top/hdmi_kiss/test_pattern_generator.sv
read_verilog -sv ../../rtl/top/hdmi_kiss/top_hdmi_test.sv

# Basic optimizations
proc
opt
memory  
opt
techmap
abc
clean

hierarchy -top top_hdmi_test
synth_ecp5 -json top_hdmi_test.json