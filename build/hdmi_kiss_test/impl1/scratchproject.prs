add_file -verilog -vlog_std sysv "//wsl.localhost/Ubuntu/home/valery/asv/rtl/core/hdmi_kiss/video_pll.sv"
add_file -verilog -vlog_std sysv "//wsl.localhost/Ubuntu/home/valery/asv/rtl/core/hdmi_kiss/hdmi_scaler_core.sv"
add_file -verilog -vlog_std sysv "//wsl.localhost/Ubuntu/home/valery/asv/rtl/core/hdmi_kiss/hdmi_scaler_wrapper.sv"
add_file -verilog -vlog_std sysv "//wsl.localhost/Ubuntu/home/valery/asv/rtl/core/hdmi_kiss/tmds_encoder.sv"
