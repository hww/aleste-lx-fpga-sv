# Makefile for Lattice Diamond on Windows
PROJECT = hdmi_test
DEVICE = LFE5U-25F
PACKAGE = CABGA256
FREQ = 25

# Diamond tools
DIAMOND_DIR = /mnt/c/lscc/diamond/3.14/bin/nt64
SYNPLIFY = $(DIAMOND_DIR)/synpwrap.exe
MAP = $(DIAMOND_DIR)/map.exe
PAR = $(DIAMOND_DIR)/par.exe
DBUILD = $(DIAMOND_DIR)/dbuild.exe
PROG = icyprog

# Source files
SRC_DIR = ../../rtl
TOP_DIR = ../../rtl/top/hdmi_kiss
CORE_DIR = ../../rtl/core/hdmi_kiss

SOURCES = \
	$(CORE_DIR)/ecp5_pll.v \
	$(CORE_DIR)/ecp5_cells.v \
	$(CORE_DIR)/sys_pll.sv \
	$(CORE_DIR)/video_pll.sv \
	$(CORE_DIR)/hdmi_scaler_core.sv \
	$(CORE_DIR)/hdmi_scaler_wrapper.sv \
	$(CORE_DIR)/tmds_encoder.sv \
	$(TOP_DIR)/test_pattern_generator.sv \
	$(TOP_DIR)/top_hdmi_test.sv

# Constraint file
CONSTR = ../../constr/ice_sugar_pro_bg256_hdmi.lpf

all: $(PROJECT).bit

# Create Synplify project file
$(PROJECT).prj: $(SOURCES) $(CONSTR)
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/core/hdmi_kiss/ecp5_pll.v\"" > $@
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/core/hdmi_kiss/ecp5_cells.v\"" >> $@
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/core/hdmi_kiss/sys_pll.sv\"" >> $@
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/core/hdmi_kiss/video_pll.sv\"" >> $@
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/core/hdmi_kiss/hdmi_scaler_core.sv\"" >> $@
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/core/hdmi_kiss/hdmi_scaler_wrapper.sv\"" >> $@
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/core/hdmi_kiss/tmds_encoder.sv\"" >> $@
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/top/hdmi_kiss/test_pattern_generator.sv\"" >> $@
	@echo "add_file -verilog -vlog_std sysv \"../../rtl/top/hdmi_kiss/top_hdmi_test.sv\"" >> $@
	@echo "add_file -lpf \"../../constr/ice_sugar_pro_bg256_hdmi.lpf\"" >> $@
	@echo "impl -add impl1 -type fpga" >> $@
	@echo "set_option -technology ECP5" >> $@
	@echo "set_option -part $(DEVICE)" >> $@
	@echo "set_option -package $(PACKAGE)" >> $@
	@echo "set_option -speed_grade 6" >> $@
	@echo "set_option -default_enum_encoding default" >> $@
	@echo "set_option -symbolic_fsm_compiler 1" >> $@

# Synthesis using Synplify
$(PROJECT).edf: $(PROJECT).prj
	$(SYNPLIFY) -prj $(PROJECT).prj -log $(PROJECT)_syn.log

# Place and Route
$(PROJECT)_map.udb: $(PROJECT).edf
	$(MAP) $(PROJECT).edf -a $(DEVICE) -p $(PACKAGE) -t $(FREQ) -o $@

$(PROJECT).udb: $(PROJECT)_map.udb
	$(PAR) $< $@

# Bitstream generation
$(PROJECT).bit: $(PROJECT).udb
	$(DBUILD) $< -f $(FREQ) -bit $@

# Program the device
program: $(PROJECT).bit
	$(PROG) $<

clean:
	rm -f *.edf *.udb *.bit *.log *.xml *.twr *.vm6 *.srs *.synlog *.prj

.PHONY: all program clean