# iCESugar-pro HDMI Constraint File

LOCATE COMP "clk_25mhz" SITE "P6";
IOBUF  PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# HDMI Differential Pairs
LOCATE COMP "gpdi_dp[0]" SITE "G1"; # Blue +
LOCATE COMP "gpdi_dn[0]" SITE "F1"; # Blue -
LOCATE COMP "gpdi_dp[1]" SITE "J1"; # Green +
LOCATE COMP "gpdi_dn[1]" SITE "H2"; # Green -
LOCATE COMP "gpdi_dp[2]" SITE "L1"; # Red +
LOCATE COMP "gpdi_dn[2]" SITE "K2"; # Red -
LOCATE COMP "gpdi_dp[3]" SITE "E2"; # Clock +
LOCATE COMP "gpdi_dn[3]" SITE "D3"; # Clock -

IOBUF PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33 DRIVE=12;
IOBUF PORT "gpdi_dn[0]" IO_TYPE=LVCMOS33 DRIVE=12;
IOBUF PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33 DRIVE=12;
IOBUF PORT "gpdi_dn[1]" IO_TYPE=LVCMOS33 DRIVE=12;
IOBUF PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33 DRIVE=12;
IOBUF PORT "gpdi_dn[2]" IO_TYPE=LVCMOS33 DRIVE=12;
IOBUF PORT "gpdi_dp[3]" IO_TYPE=LVCMOS33 DRIVE=12;
IOBUF PORT "gpdi_dn[3]" IO_TYPE=LVCMOS33 DRIVE=12;

LOCATE COMP "rst" SITE "L14";
IOBUF PORT "rst" IO_TYPE=LVCMOS33;

# Buttons
LOCATE COMP "btn[0]" SITE "A11";
IOBUF  PORT "btn[0]" PULLMODE=UP IO_TYPE=LVCMOS33;

LOCATE COMP "wifi_gpio0" SITE "A11";
IOBUF  PORT "wifi_gpio0" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# Clock constraints
FREQUENCY PORT "clk_96m" 96 MHZ;
FREQUENCY PORT "video_clk" 27 MHZ;
FREQUENCY PORT "video_clk_10x" 270 MHZ;


LOCATE COMP "led_r_o" SITE "B11";
LOCATE COMP "led_g_o" SITE "A11";
LOCATE COMP "led_b_o" SITE "A12";

IOBUF PORT "led_r_o" IO_TYPE=LVCMOS25;
IOBUF PORT "led_g_o" IO_TYPE=LVCMOS25;
IOBUF PORT "led_b_o" IO_TYPE=LVCMOS25;

LOCATE COMP "debug_0" SITE "E1";
LOCATE COMP "debug_1" SITE "F2";
LOCATE COMP "debug_2" SITE "C2";
LOCATE COMP "debug_3" SITE "D1";
LOCATE COMP "debug_4" SITE "B2";
LOCATE COMP "debug_5" SITE "C1";
LOCATE COMP "debug_6" SITE "A2";
LOCATE COMP "debug_7" SITE "B1";

//IOBUF PORT "debug_0" IO_TYPE=LVCMOS25;
//IOBUF PORT "debug_1" IO_TYPE=LVCMOS25;
//IOBUF PORT "debug_2" IO_TYPE=LVCMOS25;
//IOBUF PORT "debug_3" IO_TYPE=LVCMOS25;
//IOBUF PORT "debug_4" IO_TYPE=LVCMOS25;
//IOBUF PORT "debug_5" IO_TYPE=LVCMOS25;
