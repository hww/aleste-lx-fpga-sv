BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# ===========================================
# Clock Inputs
# ===========================================
LOCATE COMP "clk_25mhz" SITE "P6";
IOBUF PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# ===========================================
# Clock Constraints
# ===========================================
FREQUENCY NET "clk_27m" 27 MHZ;
FREQUENCY NET "clk_54m" 54 MHZ; 
FREQUENCY NET "clk_100m" 100 MHZ;
FREQUENCY NET "clk_270m" 270 MHZ;

# ===========================================
# HDMI Outputs - правильные имена для aleste_video
# ===========================================
LOCATE COMP "gpdi_dp[0]" SITE "G1"; IOBUF PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dn[0]" SITE "F1"; IOBUF PORT "gpdi_dn[0]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dp[1]" SITE "J1"; IOBUF PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dn[1]" SITE "H2"; IOBUF PORT "gpdi_dn[1]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dp[2]" SITE "L1"; IOBUF PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dn[2]" SITE "K2"; IOBUF PORT "gpdi_dn[2]" IO_TYPE=LVCMOS33 DRIVE=4;

# HDMI Clock outputs - правильные имена
LOCATE COMP "gpdi_clock_p" SITE "E2"; 
IOBUF PORT "gpdi_clock_p" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_clock_n" SITE "D3";
IOBUF PORT "gpdi_clock_n" IO_TYPE=LVCMOS33 DRIVE=4;

# ===========================================
# SDRAM Interface (из sdram_test)
# ===========================================
LOCATE COMP "sdram_clock" SITE "R15";
IOBUF PORT "sdram_clock" PULLMODE=NONE DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;

