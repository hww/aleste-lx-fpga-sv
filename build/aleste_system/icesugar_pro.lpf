# ===========================================
# Serial
# ===========================================

LOCATE      COMP "serial_tx"       SITE "E14";  
IOBUF       PORT "serial_tx"       IO_TYPE=LVCMOS33;
LOCATE      COMP "serial_rx"       SITE "E13";
IOBUF       PORT "serial_rx"       IO_TYPE=LVCMOS33;

# ===========================================
# Debug Outputs
# ===========================================
# LOCATION OF DEBUG PINS ON THE PCB
# --------------------------------------+
#    |          | F2 D1 C1 B1 GND       |  
#    | HDMI CON | E1 C2 B2 A2 GND       |
#    +----------+                       |
#                                       |
# --------------------------------------+

LOCATE COMP "debug[0]" SITE "E1"; IOBUF PORT "debug[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug[1]" SITE "F2"; IOBUF PORT "debug[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug[2]" SITE "C2"; IOBUF PORT "debug[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug[3]" SITE "D1"; IOBUF PORT "debug[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug[4]" SITE "B2"; IOBUF PORT "debug[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug[5]" SITE "C1"; IOBUF PORT "debug[5]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug[6]" SITE "A2"; IOBUF PORT "debug[6]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug[7]" SITE "B1"; IOBUF PORT "debug[7]" IO_TYPE=LVCMOS33;

# ===========================================
# User LEDs
# ===========================================
LOCATE COMP "debug_leds[0]" SITE "B11"; IOBUF PORT "debug_leds[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug_leds[1]" SITE "A11"; IOBUF PORT "debug_leds[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug_leds[2]" SITE "A12"; IOBUF PORT "debug_leds[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug_leds[3]" SITE "R1"; IOBUF PORT "debug_leds[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug_leds[4]" SITE "R2"; IOBUF PORT "debug_leds[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug_leds[5]" SITE "R3"; IOBUF PORT "debug_leds[5]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug_leds[6]" SITE "R4"; IOBUF PORT "debug_leds[6]" IO_TYPE=LVCMOS33;
LOCATE COMP "debug_leds[7]" SITE "R5"; IOBUF PORT "debug_leds[7]" IO_TYPE=LVCMOS33;


# ===========================================
# JTAG 2
# ===========================================
#   TCK:  iCELink-PA14 -- ECP5-IO-PL8D  (25F-BG256-F5)
#   TMS:  iCELink-PA13 -- ECP5-IO-PL17A (25F-BG256-H5)
#   TDI:  iCELink-PA0  -- ECP5-IO-PL38A (25F-BG256-N4)
#   TDO:  iCELink-PA1  -- ECP5-IO-PL17D (25F-BG256-J5)
LOCATE COMP "jtag2_tck" SITE "F5"; IOBUF PORT "jtag2_tck" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "jtag2_tms" SITE "H5"; IOBUF PORT "jtag2_tms" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "jtag2_tdi" SITE "N4"; IOBUF PORT "jtag2_tdi" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "jtag2_tdo" SITE "J5"; IOBUF PORT "jtag2_tdo" IO_TYPE=LVCMOS33 DRIVE=4;