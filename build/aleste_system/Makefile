# Toolchain
YOSYS      := yosys
NEXTPNR    := nextpnr-ecp5
ECPPACK    := ecppack

# Source directories
SRC_DIR     := ../../src
SYSTEM_DIR  := $(SRC_DIR)/systems/aleste_system
VIDEO_DIR   := $(SRC_DIR)/systems/aleste_video
TARGET_DIR  := $(SRC_DIR)/platforms/icesugar_pro
RESET_DIR   := $(SRC_DIR)/components/reset
CLOCK_DIR   := $(SRC_DIR)/components/clocks
SDRAM_DIR   := $(SRC_DIR)/components/memory/sdram
WB_DIR      := $(SRC_DIR)/components/interconnect/wishbone
LLHDMI_DIR  := $(SRC_DIR)/components/video/llhdmi
SCALER_DIR  := $(SRC_DIR)/components/video/hdmi_scaler
CRTC_DIR    := $(SRC_DIR)/components/video/mc6845mod
PALETTE_DIR := $(SRC_DIR)/components/video/palette
PIXPIPE_DIR := $(SRC_DIR)/components/video/pixel_pipeline
VIDBUF_DIR  := $(SRC_DIR)/components/video/video_buffer
DEBUG_DIR   := $(SRC_DIR)/components/debug
UART_DIR    := $(SRC_DIR)/components/io/uart
CPU_DIR     := $(SRC_DIR)/components/cpu
MMU_DIR     := $(SRC_DIR)/components/memory/mmu

# Source files для aleste_system - ТОЛЬКО VERILOG!
DEBUG       := $(DEBUG_DIR)/debug_shift_reg.sv
RESET_CTRL  := $(RESET_DIR)/reset_controller.sv
CLOCK_CTRL  := $(CLOCK_DIR)/system_clock.sv
CLOCK       := $(TARGET_DIR)/clocks/system_pll.v $(TARGET_DIR)/clocks/video_pll.v
SDRAM_CTRL  := $(SDRAM_DIR)/sdram_wishbone.sv  
WB          := $(WB_DIR)/uart_bridge.sv $(WB_DIR)/wb_wdt_simple.sv
UART_BRIDGE := $(UART_DIR)/uart.v $(UART_DIR)/uart_rx.v $(UART_DIR)/uart_tx.v $(UART_DIR)/baud_tick_gen.v
HDMI        := $(LLHDMI_DIR)/llhdmi.v $(LLHDMI_DIR)/tmds_encoder.v $(LLHDMI_DIR)/OBUFDS.v
CRTC        := $(CRTC_DIR)/mc6845mod.sv 
SCALER      := $(SCALER_DIR)/dual_port_ram.sv $(SCALER_DIR)/hdmi_scaler.sv
PALETTE     := $(PALETTE_DIR)/cpc_colors.sv $(PALETTE_DIR)/msx_colors.sv $(PALETTE_DIR)/color_palette.sv
VIDBUF      := $(VIDBUF_DIR)/video_buffer.sv
PIXPIPE	    := $(PIXPIPE_DIR)/pixel_pipeline.sv
VIDEO       := $(VIDEO_DIR)/memory_arbiter.sv $(VIDEO_DIR)/wb_arbiter.sv $(VIDEO_DIR)/video_ctrl.sv $(VIDEO_DIR)/address_decoder.sv 
SYSTEM      := $(SYSTEM_DIR)/z80_system.sv $(SYSTEM_DIR)/system_arbiter.sv $(SYSTEM_DIR)/z80_debug.sv 
MMU         := $(MMU_DIR)/mmu_legacy.sv $(MMU_DIR)/mmu_native.sv

# TV80 Verilog CPU core
TV80_CORE   := $(CPU_DIR)/tv80/tv80_core.v
TV80_REG    := $(CPU_DIR)/tv80/tv80_reg.v
TV80_ALU    := $(CPU_DIR)/tv80/tv80_alu.v
TV80_MCODE  := $(CPU_DIR)/tv80/tv80_mcode.v
TV80_PACK   := $(CPU_DIR)/tv80/tv80s.v  # Используем tv80s.v вместо pack

CPU_VERILOG := $(TV80_CORE) $(TV80_REG) $(TV80_ALU) $(TV80_MCODE) $(TV80_PACK)

TOP_MODULE  := $(SYSTEM_DIR)/aleste_system.sv

# ALL_SOURCES для правильных зависимостей
ALL_SOURCES := $(TOP_MODULE) $(CLOCK) $(SDRAM_CTRL) $(HDMI) $(CRTC) $(SCALER) \
               $(PALETTE) $(SYSTEM) $(PIXPIPE) \
               $(RESET_CTRL) $(DEBUG) $(VIDBUF) $(UART_BRIDGE) $(WB) $(CLOCK_CTRL) $(VIDEO) \
               $(CPU_VERILOG) $(MMU)

# Generated files
YOSYS_SCRIPT := aleste_system.ys
JSON_FILE    := aleste_system.json
CONFIG_FILE  := aleste_system.config
BITSTREAM    := aleste_system.bit
SVF_FILE     := aleste_system.svf

# Target board configuration
DEVICE      := 25k
PACKAGE     := CABGA256
CONSTRAINTS := icesugar_pro.lpf

# Configuration
YOSYS_DEFINE := -DCONFIG_27MHZ -I../../src/config
YOSYS_INCLUDE := -I. -I$(SYSTEM_DIR)

.PHONY: all
all: $(BITSTREAM)

# Generate Yosys script ТОЛЬКО Verilog
$(YOSYS_SCRIPT): $(ALL_SOURCES)
	@echo "Generating Yosys script for aleste_system (Verilog only)..."
	@echo "# Auto-generated by Makefile" > $@
	@echo "# TV80 CPU Core" >> $@
	@for vfile in $(CPU_VERILOG); do \
		echo "read_verilog $$vfile" >> $@; \
	done
	@echo "# SystemVerilog files" >> $@
	@echo "read_verilog $(YOSYS_INCLUDE) $(YOSYS_DEFINE) -sv $(TOP_MODULE)" >> $@
	@echo "read_verilog $(CLOCK)" >> $@
	@echo "read_verilog $(HDMI)" >> $@
	@echo "read_verilog -sv $(VIDBUF)" >> $@
	@echo "read_verilog -sv $(DEBUG)" >> $@
	@echo "read_verilog -sv $(WB)" >> $@
	@echo "read_verilog -sv $(SDRAM_CTRL)" >> $@
	@echo "read_verilog -sv $(UART_BRIDGE)" >> $@
	@echo "read_verilog -sv $(CRTC)" >> $@
	@echo "read_verilog -sv $(SCALER)" >> $@
	@echo "read_verilog -sv $(PALETTE)" >> $@
	@echo "read_verilog -sv $(VIDEO)" >> $@
	@echo "read_verilog -sv $(MMU)" >> $@
	@echo "read_verilog -sv $(SYSTEM)" >> $@
	@echo "read_verilog -sv $(PIXPIPE)" >> $@
	@echo "read_verilog -sv $(CLOCK_CTRL)" >> $@
	@echo "read_verilog -sv $(RESET_CTRL)" >> $@
	@echo "# Hierarchy and synthesis" >> $@
	@echo "hierarchy -top aleste_system" >> $@
	@echo "tee -o stats_pre.txt stat" >> $@
	@echo "synth_ecp5 -json $(JSON_FILE) -no-rw-check" >> $@
	@echo "tee -o stats_synt.txt stat" >> $@
	@echo "# Sources: $(words $(ALL_SOURCES)) files" >> $@

# Synthesis with Yosys
$(JSON_FILE): $(YOSYS_SCRIPT)
	@echo "Running Yosys synthesis..."
	$(YOSYS) -q $<
	@touch $@

# Place and route with nextpnr
$(CONFIG_FILE): $(JSON_FILE)
	@echo "Running place and route..."
	$(NEXTPNR) \
		--$(DEVICE) \
		--speed 6 --timing-allow-fail  --seed 1 \
		--package $(PACKAGE) \
		--json $< \
		--lpf $(CONSTRAINTS) \
		--textcfg $@

# Generate bitstream
$(BITSTREAM): $(CONFIG_FILE)
	@echo "Generating bitstream..."
	$(ECPPACK) \
		--input $< \
		--bit $@ \
		--svf $(SVF_FILE)

.PHONY: clean
clean:
	@echo "Cleaning build artifacts..."
	rm -f $(YOSYS_SCRIPT) $(JSON_FILE) $(CONFIG_FILE) $(BITSTREAM) $(SVF_FILE)
	rm -f aleste_system.ys *.json *.config *.bit *.svf
	find . -name "*.tmp" -delete

.PHONY: check-sources
check-sources:
	@echo "Checking $(words $(ALL_SOURCES)) source files..."
	@for file in $(ALL_SOURCES); do \
		if [ -f "$$file" ]; then \
			echo "✓ $$file"; \
		else \
			echo "✗ $$file (MISSING)"; \
			exit 1; \
		fi \
	done

.PHONY: rebuild  
rebuild: clean check-sources all

.PHONY: program
program: $(BITSTREAM)
	@echo "Programming board..."
	openocd -f icelink.cfg

# Проверить TV80 файлы
.PHONY: check-tv80
check-tv80:
	@echo "Checking TV80 files..."
	@for file in $(CPU_VERILOG); do \
		if [ -f "$$file" ]; then \
			echo "✓ $$file"; \
		else \
			echo "✗ $$file (MISSING)"; \
		fi \
	done