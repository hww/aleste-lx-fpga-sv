int main(int argc, char** argv) {
    Verilated::commandArgs(argc, argv);
    Verilated::traceEverOn(true);
    
    vluint64_t main_time = 0;
    VerilatedVcdC* tfp = new VerilatedVcdC;
    
    Vtv80_lx_wb* top = new Vtv80_lx_wb;
    top->trace(tfp, 99);
    tfp->open("tv80_lx_wb_test.vcd");
    
    TV80LXTestUtils utils(top, main_time, tfp);
    
    std::cout << "=== COMPREHENSIVE TV80-LX-WB TEST SUITE ===" << std::endl;
    
    // Run all real tests
    utils.reset_pulse();
    
    test_native_mode_switch(utils);
    test_syscall_functionality(utils);
    test_memory_banking(utils);
    test_supervisor_trap(utils);
    test_legacy_mode_compatibility(utils);
    
    utils.print_test_results();
    
    tfp->close();
    delete top;
    delete tfp;
    
    return (utils.get_test_failures() == 0) ? 0 : 1;
}