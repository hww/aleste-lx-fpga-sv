class MMUNativeTestUtils {
private:
    // ... (поля класса остаются те же) ...

public:
    // ... (конструктор и базовые методы) ...

    // Clock management
    void eval(int delta) {
        top->eval();
        if (tfp) tfp->dump(main_time);
        main_time += delta;
    }

    void clock_low(int delay) {
        top->clk = 0;
        eval(delay);
    }

    void clock_high(int delay) {
        top->clk = 1;
        eval(delay);
        
        // Обработка Wishbone Master на rising edge!
        handle_m_wb_response();
        
        if (top->syscall_trigger_o) syscall_trig_seen = true;
    }

    void clock_tick() {
        clock_high(CLK_HALF_PERIOD);
        clock_low(CLK_HALF_PERIOD);
    }

    void handle_m_wb_response() {
        // Monitor Wishbone Master interface and generate responses
        if (top->m_wb_cyc_o && top->m_wb_stb_o) {
            m_wb_transaction_occurred = true;
            last_m_wb_addr = top->m_wb_adr_o;
            
            if (top->m_wb_we_o) {
                // Write transaction
                last_m_wb_data = top->m_wb_dat_o;
                if (m_wb_write_callback) {
                    m_wb_write_callback(last_m_wb_addr, last_m_wb_data);
                }
                std::cout << "WB Master WRITE: addr=0x" << std::hex << last_m_wb_addr 
                          << " data=0x" << (int)last_m_wb_data << std::dec << std::endl;
            } else {
                // Read transaction
                uint8_t response_data = 0xAA; // Default
                if (m_wb_read_callback) {
                    response_data = m_wb_read_callback(last_m_wb_addr);
                }
                top->m_wb_dat_i = response_data;
                std::cout << "WB Master READ: addr=0x" << std::hex << last_m_wb_addr 
                          << " response=0x" << (int)response_data << std::dec << std::endl;
            }
            
            // Generate ACK
            top->m_wb_ack_i = 1;
        } else {
            // No active transaction
            top->m_wb_ack_i = 0;
        }
    }

    void set_m_wb_delegates(std::function<uint8_t(uint32_t)> read_callback = nullptr,
                           std::function<void(uint32_t, uint8_t)> write_callback = nullptr) {
        m_wb_read_callback = read_callback;
        m_wb_write_callback = write_callback;
    }

    // Z80 Bus simulation - УПРОЩЕННАЯ версия без вызова handle_m_wb_response
    void simulate_z80_memory_access(uint16_t addr, bool is_write, uint8_t data = 0) {
        std::cout << "Z80 Memory Access: addr=0x" << std::hex << addr 
                  << " " << (is_write ? "WRITE" : "READ") 
                  << " data=0x" << (int)data << std::dec << std::endl;
        
        z80_bus_idle();
        
        // Set address and data
        top->cpu_a = addr;
        if (is_write) top->cpu_din = data;
        
        // Activate signals
        clock_high(SETUP_TIME);
        top->cpu_mreq_n = 0;
        if (is_write) {
            top->cpu_wr_n = 0;
        } else {
            top->cpu_rd_n = 0;
        }
        eval(CLK_REST_TIME);
        
        // Complete the cycle - handle_m_wb_response вызовется автоматически в clock_high/clock_low
        clock_low(CLK_HALF_PERIOD);
        clock_high(SETUP_TIME);
        z80_bus_idle();
        eval(CLK_REST_TIME);
        clock_low(CLK_HALF_PERIOD);
    }

    void simulate_z80_io_access(uint16_t addr, bool is_write, uint8_t data = 0) {
        std::cout << "Z80 IO Access: addr=0x" << std::hex << addr 
                  << " " << (is_write ? "WRITE" : "READ") 
                  << " data=0x" << (int)data << std::dec << std::endl;
        
        z80_bus_idle();
        
        // Set address and data
        top->cpu_a = addr;
        if (is_write) top->cpu_din = data;
        
        // Activate signals
        clock_high(SETUP_TIME);
        top->cpu_iorq_n = 0;
        if (is_write) {
            top->cpu_wr_n = 0;
        } else {
            top->cpu_rd_n = 0;
        }
        eval(CLK_REST_TIME);
        
        // Complete the cycle - handle_m_wb_response вызовется автоматически
        clock_low(CLK_HALF_PERIOD);
        clock_high(SETUP_TIME);
        z80_bus_idle();
        eval(CLK_REST_TIME);
        clock_low(CLK_HALF_PERIOD);
    }

    // ... остальные методы (reset, wishbone slave, assertions) ...
};